<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navgraph"
    app:startDestination="@id/productsList2">

    <fragment
        android:id="@+id/productsList2"
        android:name="com.example.e_commerceapp.productList.presentation.ui.ProductsListFragment"
        android:label="fragment_products_list"
        tools:layout="@layout/fragment_products_list">
        <action
            android:id="@+id/action_productsList2_to_productDetails"
            app:destination="@id/productDetailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/productDetailsFragment"
        android:name="com.example.e_commerceapp.productDetails.presentation.ui.ProductDetailsFragment"
        android:label="fragment_product_details"
        tools:layout="@layout/fragment_product_details">
        <argument
            android:name="id"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>
</navigation>